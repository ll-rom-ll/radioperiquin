# Desarrollo local
HOST=0.0.0.0
PORT=8787
RADIO_ADMIN_TOKEN=cambia-este-token-por-uno-largo-y-aleatorio

# URL pública HTTPS del Cloud, sin slash final.
# En Render actual:
PUBLIC_BASE_URL=https://radioperiquin.onrender.com

# Persistencia externa recomendada (Supabase)
# Project URL: Settings/Connect en Supabase.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Usa una Secret key sb_secret_... SOLO en Render/backend.
# Nunca la pongas en Android, Studio Desktop o GitHub.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
# Compatibilidad opcional con claves legacy:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_MEDIA_BUCKET=radio-periquin-media

# Fallback local. Cloud sigue funcionando sin Supabase para desarrollo.
# RADIO_STORAGE_ROOT=C:/RadioPeriquinCloudData

# Orígenes adicionales autorizados para llamadas administrativas desde navegador.
# El panel servido por el mismo backend funciona sin configurar esto.
# RADIO_ADMIN_ORIGINS=https://studio.radioperiquin.com

RADIO_ADMIN_RATE_LIMIT=120

# Realtime push (SSE). Los valores por defecto son adecuados para la primera etapa.
RADIO_REALTIME_HEARTBEAT_SECONDS=20
RADIO_REALTIME_MAX_CLIENTS=2000
