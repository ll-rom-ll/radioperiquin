# Desarrollo local
HOST=0.0.0.0
PORT=8787
RADIO_ADMIN_TOKEN=cambia-este-token-por-uno-largo-y-aleatorio

# Producción: URL pública HTTPS del servicio, sin slash final.
# PUBLIC_BASE_URL=https://radio-periquin-cloud.onrender.com

# Directorio persistente. En Render con disco: /var/data/radio-periquin
# RADIO_STORAGE_ROOT=/var/data/radio-periquin

# Orígenes adicionales autorizados para llamadas administrativas desde navegador.
# El panel servido por el mismo backend funciona sin configurar esto.
# RADIO_ADMIN_ORIGINS=https://studio.radioperiquin.com

# Máximo de solicitudes administrativas por IP/minuto.
RADIO_ADMIN_RATE_LIMIT=120
